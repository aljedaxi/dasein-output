#!/usr/bin/env nix
#! nix shell github:aljedaxi/de-logseqify-markdown --command bash
#grab dc.type=text files and convert them to html

while read x; 
do
  justName=`basename "${x%.*}" | sed "s/ /-/g"`
  mkdir -p $1/${justName}
  { echo "<title>${justName}</title>"
    de-logseqify-markdown "$HOME/zettel/pages/$x.md"
  } | janet layout.janet > $1/${justName}/index.html
done < /dev/stdin
