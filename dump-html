#!/usr/bin/env nix
#! nix shell github:aljedaxi/de-logseqify-markdown --command bash
#grab dc.type=text files and convert them to html

while read x; 
do
  justName=`echo ${x} | sed "s/ /-/g"`
  index="${justName}/index.html"
  mkdir -p $1/${justName}
  { echo "<title>${x}</title>"
    echo "<meta property=\"og:url\" content=\"https://dasein-online.ca/articles/${index}\"/>"
    de-logseqify-markdown "$HOME/zettel/pages/$x.md"
  } | janet layout.janet > $1/${index}
done < /dev/stdin
